# --- Meta / Instagram ---
# Token de acceso de pagina/IG con permisos instagram_business_manage_messages,
# instagram_business_manage_comments (Standard Access, sobre tu propia cuenta).
IG_ACCESS_TOKEN=

# El ID de tu cuenta profesional de Instagram (Instagram Business Account ID),
# no el @usuario. Se obtiene desde el API setup de Instagram en el dashboard de la app.
IG_ACCOUNT_ID=

# Cadena secreta que TU inventas. Debe coincidir exactamente con el Verify Token
# que pongas en el dashboard de Meta al configurar el webhook.
META_VERIFY_TOKEN=cambia-esto-por-una-frase-secreta

# App Secret de tu app de Meta (App settings > Basic > App Secret).
# Se usa para verificar que los webhooks realmente vienen de Meta.
META_APP_SECRET=

# --- OpenAI (GPT) --- motor que genera todas las respuestas del bot
OPENAI_API_KEY=
# Opcional: modelo a usar (por defecto gpt-5.6-sol)
OPENAI_MODEL=

# --- WhatsApp (360dialog) ---
# Secreto compartido: debe coincidir EXACTAMENTE con el valor del
# encabezado personalizado "X-360dialog-Secret" configurado en el panel de
# 360dialog (Configuracion de API > URL de webhook del canal / WABA).
# Sin este valor, el endpoint /webhook/whatsapp acepta cualquier peticion
# sin verificar su origen -- ponlo siempre en produccion.
WHATSAPP_WEBHOOK_SECRET=

# Clave de API del canal de 360dialog (Configuracion de API > Clave de
# API). Se guarda aqui para uso futuro (enviar mensajes salientes via la
# API de 360dialog); el webhook actual solo RECIBE eventos y no la
# necesita todavia.
WHATSAPP_360DIALOG_API_KEY=

# --- Persistencia (SQLite) ---
# Carpeta donde se guarda el estado del bot de Instagram (data/state.json)
# y ahora tambien el registro de eventos (data/events.db). Debe apuntar a
# un volumen persistente de Railway -- si no, se pierde en cada redeploy.
DATA_DIR=

# --- Servidor ---
PORT=3000

# Notificacion opcional cuando un mensaje se escala a revision humana
# (deja vacio para desactivar). Puede ser un webhook de Slack/Discord, por ejemplo.
ESCALATION_WEBHOOK_URL=
